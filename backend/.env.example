# ============ 基础 ============
PORT=3000
# 生产请务必替换为强随机密钥（长度>=32），勿沿用默认
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRES_IN=7d

# 前端跨域来源（逗号分隔；同源反代部署可保持默认）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 数据库 ============
# 本地/开发：不设置 DB_DIALECT 即用内置 SQLite（node:sqlite，零配置）
# DB_PATH=./data.sqlite

# 生产：切换为 MySQL（DB_DIALECT=mysql 时必须提供下面连接信息）
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=career
# DB_PASSWORD=your_password
# DB_NAME=career_planner

# ============ AI 配置（智谱 GLM，OpenAI 兼容接口；base_url 固定为 /api/paas/v4/） ============
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 生产请用云环境变量注入，勿提交真实 Key
AI_API_KEY=your_zhipu_api_key
AI_MODEL=glm-4-flash

# ============ 邮箱 SMTP 配置（忘记密码验证码） ============
# 生产建议用企业/云邮件服务，勿用个人 163 授权码上线
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_USER=your_account
# SMTP_PASS=your_auth_code
# SMTP_FROM=职引 <your_sender_address>