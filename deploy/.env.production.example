# 职引 · 生产环境变量模板
# 用法：cp deploy/.env.production.example /var/www/career-planner/backend/.env 后按需修改
# !!! 生产必须是强密钥，切勿沿用本地测试值；API Key 用真实密钥 !!!

# 后端
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_32+_random_chars
JWT_EXPIRES_IN=7d

# 跨域来源：若走 nginx 同源反代可保持默认（同源不触发 CORS）；前后端分域时填入前端域名
CORS_ORIGINS=https://your.domain.com

# 数据库（MySQL）
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=career
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=career_planner

# AI（智谱 GLM）
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
AI_API_KEY=your_real_zhipu_key
AI_MODEL=glm-4-flash

# 邮件 SMTP（找回密码验证码）——生产建议企业/云邮件服务
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_USER=your_account
# SMTP_PASS=your_auth_code
# SMTP_FROM=职引 <your_sender_address>